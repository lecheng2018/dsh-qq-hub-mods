{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lecheng2018/dsh-qq-hub-mods/blob/main/schemas/revoked.schema.json",
  "title": "Exact-version security revocations",
  "type": "object",
  "required": ["revoked"],
  "properties": {
    "$schema": { "type": "string" },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "versions", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}(?![\\s\\S])" },
          "versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "module.schema.json#/$defs/semver" } },
          "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
