{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lecheng2018/dsh-qq-hub-mods/blob/main/schemas/module.schema.json",
  "title": "Market module source manifest (API 1)",
  "type": "object",
  "required": ["id", "name", "version", "description", "author", "license", "api"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}(?![\\s\\S])" },
    "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "author": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "license": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "api": { "const": 1 },
    "category": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "minPluginVersion": { "$ref": "#/$defs/semver" },
    "requires": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}(?![\\s\\S])" }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://[^@\\s]+(?![\\s\\S])" },
    "replacesBuiltin": { "type": "boolean" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    }
  },
  "additionalProperties": false
}
